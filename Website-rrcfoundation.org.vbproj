<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>RRCFoundation</RootNamespace>
    <OutputType>Library</OutputType>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="*.aspx;*.master;*.html">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Classic ASP.NET (System.Web) only probes /bin for private assemblies;
       dotnet publish otherwise drops the compiled assembly at the publish root. -->
  <Target Name="MoveOutputAssemblyToBin" AfterTargets="Publish">
    <ItemGroup>
      <_BinOutputFiles Include="$(PublishDir)$(AssemblyName).*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)bin" Condition="!Exists('$(PublishDir)bin')" />
    <Move SourceFiles="@(_BinOutputFiles)" DestinationFolder="$(PublishDir)bin" />
  </Target>

</Project>
